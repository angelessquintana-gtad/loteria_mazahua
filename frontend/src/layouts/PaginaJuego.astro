---
// Conserva las plantillas y scripts de las partidas ya probadas. Astro genera
// el documento final en build; FastAPI se encarga del acceso antes de entregarlo.
interface Props { documento: string; rol?: string; clase?: string; privada?: boolean }
const { documento, rol, clase, privada = false } = Astro.props;
const cabeza = documento.match(/<head>([\s\S]*?)<\/head>/i)?.[1] ?? '';
const cuerpo = documento.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? '';
---
<!doctype html>
<html lang="es">
  <head>
    <Fragment set:html={cabeza} />
    {privada && <script is:inline src="/static/sesion-docente.js?v=4"></script>}
    {rol !== 'estudiante' && <link rel="stylesheet" href="/static/extras.css?v=12" />}
    {rol !== 'estudiante' && !documento.includes('navegacion.js') && <script is:inline src="/static/navegacion.js?v=2" defer></script>}
    <link rel="stylesheet" href="/static/tema.css?v=7" />
    <link rel="icon" type="image/png" href="/static/img/favicon.png" />
    <meta name="theme-color" content="#74203d" />
    <script is:inline src="/static/tema.js?v=4"></script>
  </head>
  <body class={clase} data-role={rol}><Fragment set:html={cuerpo} /></body>
</html>
