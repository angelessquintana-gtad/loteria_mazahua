DOMAIN=tu-loteria.duckdns.org
ACME_EMAIL=tu-correo@example.com
# Incluir dominio e IP de loopback para el healthcheck interno; sin https://.
ALLOWED_HOSTS=tu-loteria.duckdns.org,127.0.0.1,localhost
DB_NAME=loteria_mazahua
DB_USER=mazahua
DB_PASSWORD=CAMBIAR_POR_UN_SECRETO_ALEATORIO
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
JWT_MINUTES=120
ROOM_IDLE_MINUTES=60
ROOM_MAX_HOURS=8
ROOM_RETENTION_DAYS=7
CLEANUP_INTERVAL_SECONDS=60
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Correo transaccional de la escuela. PUBLIC_URL se forma con DOMAIN en Compose.
SMTP_HOST=
SMTP_PORT=587
# starttls (587) o ssl (465); siempre cifrado.
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
