DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=loteria_mazahua

# false: el navegador conecta el USB del docente o administrador.
# true: puente Python antiguo, solo para el equipo con el lector local.
SERIAL_ENABLED=false
SERIAL_PORT=COM13
SERIAL_BAUD=115200
API_URL=http://127.0.0.1:8000

# Cada docente crea su propia cuenta en /acceso (nombre, correo y contraseña de 6+ caracteres).
# Para VPS usar deploy/.env.example y la guía deploy/ORACLE.md.
APP_ENV=development
AUTO_MIGRATE=true
ROOM_IDLE_MINUTES=60
ROOM_MAX_HOURS=8
ROOM_RETENTION_DAYS=7
CLEANUP_INTERVAL_SECONDS=60

# En desarrollo se genera .jwt-secret al arrancar si JWT_SECRET está vacío.
# En producción JWT_SECRET es obligatorio: generar con secrets.token_urlsafe(48).
JWT_SECRET=
JWT_MINUTES=120

# Correo de recuperación de contraseña ("¿Olvidaste tu contraseña?").
# Sin SMTP: el enlace aparece en la ventana del servidor y en la pantalla si la solicitud
# se hace desde esta misma computadora. Para enviarlo por correo con Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tu_correo@gmail.com
#   SMTP_PASSWORD=<contraseña de aplicación de 16 letras>  SMTP_FROM=tu_correo@gmail.com
# y en PUBLIC_URL la dirección con la que los docentes abren el sistema (ej. http://192.168.1.50:8000 no sirve: debe ser https
# o http://127.0.0.1:8000 en esta computadora).
PUBLIC_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Alternativa nube: MySQL externo con TLS + Supabase solo para archivos.
DB_SSL=false
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_BUCKET=loteria-media
SUPABASE_SERVICE_KEY=
# Render bloquea SMTP: se puede usar API HTTPS con remitente verificado.
MAIL_PROVIDER=smtp
BREVO_API_KEY=
MAIL_FROM=

# --- Despliegue separado (frontend en Vercel, backend en Render) ---
# Dirección pública del frontend (Vercel). Se usa para el QR y para aceptar sus peticiones.
# FRONTEND_URL=https://loteria-mazahua.vercel.app
# Opcional: dirección del WebSocket si no es Render (por defecto wss://RENDER_EXTERNAL_HOSTNAME).
# WS_PUBLIC_URL=wss://loteria-mazahua-escuela.onrender.com
